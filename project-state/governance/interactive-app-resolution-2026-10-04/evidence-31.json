      "descOpenAtStart": false,
      "accordionSize": "small",
      "title": "Transportation Equity Assessment for the Albuquerque Metro Planning Area",
      "splash": true,
      "splashOnStart": true,
      "splashTitle": "Welcome!",
      "splashContent": "<p><span style=\"font-size:16px;\">This map series&nbsp;is a tool for evaluating the&nbsp;</span><a href=\"https://www.epa.gov/environmentaljustice/equitable-development-and-environmental-justice\" target=\"_blank\"><span style=\"font-size:16px;\">equitable development</span></a><span style=\"font-size:16px;\">&nbsp;of regional public transportation&nbsp;systems and&nbsp;to assess&nbsp;how communities&nbsp;of concern for environmental justice are served by the transportation network to&nbsp;facilitate access to transit service, parks&nbsp;and open space, grocery stores, and healthcare facilities (see </span><a href=\"https://www.mrcog-nm.gov/DocumentCenter/View/4224/Chapter-9-Plan-Implementation-and-Evaluation-PDF\" target=\"_blank\"><span style=\"font-size:16px;\">section 9.2</span></a><span style=\"font-size:16px;\"> of the </span><a href=\"https://www.mrcog-nm.gov/264/Metropolitan-Transportation-Plan\" target=\"_blank\"><span style=\"font-size:16px;\">Connections 2040 Metropolitan Transportation Plan</span></a><span style=\"font-size:16px;\"> for more details).</span><br><br><span style=\"font-size:16px;\">Use the controls in the upper right corner to search for a location of interest, display the map legend, control layer visibility, or change the base-map. &nbsp;Click on the maps for a pop-up display of tract-level demographic statistics.</span></p>",
      "splashButtonText": "Explore",
